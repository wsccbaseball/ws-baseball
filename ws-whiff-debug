<!DOCTYPE html>

<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Berry Whiff Debug</title>
<style>
body{font-family:sans-serif;background:#f5f5f5;padding:20px;max-width:500px;margin:0 auto}
h2{color:#1a3a5c;margin-bottom:10px}
canvas{display:block;background:#fff;border:1px solid #ccc;margin:10px 0}
#status{font-size:.85rem;color:#666;margin-bottom:8px}
#count{font-weight:bold;color:#1a3a5c}
</style>
</head>
<body>
<h2>Jackson Berry — Raw Whiff Locations</h2>
<div id="status">Loading...</div>
<div id="count"></div>
<canvas id="cv" width="360" height="300"></canvas>
<div style="font-size:.75rem;color:#888">Each dot = one StrikeSwinging. Red = inside zone, Blue = outside zone. Catcher's view (side as-is from TrackMan).</div>

<script>
var SUPABASE_URL='https://mghrapwhvihpwgqryail.supabase.co';
var SUPABASE_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1naHJhcHdodmlocHdncXJ5YWlsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU0MjQ0NzUsImV4cCI6MjA5MTAwMDQ3NX0.ilNGmGOOc-TIpwQx0e1cTK1YjYF9TvdL7nEGUEXiWFc';

async function load(){
  document.getElementById('status').textContent='Fetching pitches...';
  var rows=[],from=0;
  while(true){
    var r=await fetch(SUPABASE_URL+'/rest/v1/pitches?PitchCall=eq.StrikeSwinging&limit=1000&offset='+from,{
      headers:{'apikey':SUPABASE_KEY,'Authorization':'Bearer '+SUPABASE_KEY}
    });
    var d=await r.json();
    if(!Array.isArray(d)||!d.length)break;
    rows=rows.concat(d);
    if(d.length<1000)break;
    from+=1000;
  }
  // Filter to Berry only
  var berry=rows.filter(function(r){
    return r.Batter&&r.Batter.toLowerCase().includes('berry')&&
           r.BatterTeam&&r.BatterTeam.toLowerCase().includes('wal');
  });
  document.getElementById('status').textContent='Done. Total StrikeSwinging in DB: '+rows.length;
  document.getElementById('count').textContent='Berry whiffs: '+berry.length;
  draw(berry);
}

function draw(pts){
  var cv=document.getElementById('cv');
  var ctx=cv.getContext('2d');
  var W=cv.width,H=cv.height,PAD=30;
  var xMin=-2,xMax=2,yMin=0,yMax=5;
  function mx(v){return PAD+(v-xMin)/(xMax-xMin)*(W-PAD*2);}
  function my(v){return H-PAD-(v-yMin)/(yMax-yMin)*(H-PAD*2);}

  ctx.fillStyle='#f8fafd';ctx.fillRect(0,0,W,H);

  // Strike zone
  ctx.strokeStyle='#1a3a5c';ctx.lineWidth=2;
  ctx.strokeRect(mx(-0.833),my(3.5),mx(0.833)-mx(-0.833),my(1.5)-my(3.5));

  // Grid lines
  ctx.strokeStyle='#ccc';ctx.lineWidth=0.5;
  var zw=(mx(0.833)-mx(-0.833))/3;
  var zh=(my(1.5)-my(3.5))/3;
  for(var i=1;i<3;i++){
    ctx.beginPath();ctx.moveTo(mx(-0.833)+zw*i,my(3.5));ctx.lineTo(mx(-0.833)+zw*i,my(1.5));ctx.stroke();
    ctx.beginPath();ctx.moveTo(mx(-0.833),my(3.5)+zh*i);ctx.lineTo(mx(0.833),my(3.5)+zh*i);ctx.stroke();
  }

  // Axes labels
  ctx.fillStyle='#888';ctx.font='9px sans-serif';ctx.textAlign='center';
  ctx.fillText('0',mx(0),my(0)-5);
  ctx.fillText('-1',mx(-1),my(0)-5);
  ctx.fillText('1',mx(1),my(0)-5);
  ctx.textAlign='right';
  ctx.fillText('1.5',mx(-2)+18,my(1.5)+3);
  ctx.fillText('3.5',mx(-2)+18,my(3.5)+3);

  // Plate
  ctx.fillStyle='#999';
  ctx.fillRect(mx(-0.708),my(0.15),mx(0.708)-mx(-0.708),4);

  // Dots
  var inZone=0,outZone=0;
  pts.forEach(function(p){
    var side=parseFloat(p.PlateLocSide);
    var height=parseFloat(p.PlateLocHeight);
    if(isNaN(side)||isNaN(height))return;
    var inside=Math.abs(side)<=0.833&&height>=1.5&&height<=3.5;
    if(inside)inZone++;else outZone++;
    ctx.beginPath();ctx.arc(mx(side),my(height),4,0,Math.PI*2);
    ctx.fillStyle=inside?'rgba(220,50,50,0.7)':'rgba(50,100,220,0.7)';
    ctx.fill();
    ctx.strokeStyle='rgba(0,0,0,0.2)';ctx.lineWidth=0.5;ctx.stroke();
  });

  // Summary
  ctx.fillStyle='#333';ctx.font='10px sans-serif';ctx.textAlign='left';
  ctx.fillText('In zone: '+inZone,10,15);
  ctx.fillText('Out zone: '+outZone,10,28);
  ctx.fillStyle='#1a3a5c';ctx.textAlign='center';
  ctx.fillText("Catcher's View (PlateLocSide as-is)",W/2,H-8);
}

load();
</script>

</body>
</html>
